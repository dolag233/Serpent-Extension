{
  "manifest_version": 3,
  "name": "Serpent",
  "version": "0.1.3",
  "description": "Save images and videos from the web to Serpent digital asset manager.",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:19876/*",
    "http://127.0.0.1:19877/*",
    "http://127.0.0.1:19878/*",
    "http://*/*",
    "https://*/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Serpent",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-gray-32.png",
      "48": "icons/icon-gray-48.png",
      "64": "icons/icon-gray-64.png",
      "128": "icons/icon-gray-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "batch-save": {
      "suggested_key": { "default": "Alt+1" },
      "description": "批量收藏当前页"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+2" },
      "description": "截取区域"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+3" },
      "description": "截取可见区域"
    },
    "capture-page": {
      "suggested_key": { "default": "Alt+4" },
      "description": "整页截图"
    },
    "capture-element": {
      "description": "截取元件"
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
